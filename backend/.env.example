# ==============================================================
# LIMS Backend — Variables d'environnement (template)
# Copier ce fichier en .env et remplir les valeurs
# ==============================================================

# Serveur
SERVER_PORT=8081

# Premier Super Administrateur (seeding initial)
SUPER_ADMIN_EMAIL=admin@lims.com
SUPER_ADMIN_PASSWORD=change-me

# CORS — origines autorisées (séparer plusieurs origines par une virgule)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base de données centrale
DB_CENTRAL_URL=jdbc:mysql://localhost:3306/lims_central?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_CENTRAL_USERNAME=
DB_CENTRAL_PASSWORD=

# JWT (secret encodé en Base64, min 32 octets. Générer avec : openssl rand -base64 64)
JWT_SECRET=
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Configuration Cookie HttpOnly pour le Refresh Token
JWT_COOKIE_NAME=refreshToken
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAME_SITE=Strict
JWT_COOKIE_PATH=/api/auth

# SendGrid — API v3 (ne jamais committer une vraie clé)
# SENDGRID_ENABLED=false désactive l'envoi réel (logs seulement en profil dev)
# L'expéditeur SENDGRID_FROM_EMAIL doit être vérifié dans SendGrid (domaine authentifié)
# Créez une clé Restricted Access : Mail Send only.
SENDGRID_ENABLED=true
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=no-reply@votre-domaine.com
SENDGRID_FROM_NAME=LabFlow LIMS
SENDGRID_TIMEOUT_MS=8000

# MinIO (stockage fichiers)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=lims-documents

# n8n (orchestration workflows)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# LLM (OpenAI ou modèle auto-hébergé compatible)
LLM_API_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.2

# Application
APP_FRONTEND_URL=http://localhost:5173
APP_TRUST_PROXY=false
APP_INSCRIPTION_MAX_PAR_IP=5
APP_INSCRIPTION_MAX_PAR_EMAIL=3
APP_INSCRIPTION_FENETRE_SECONDES=3600
APP_INSCRIPTION_TOKEN_EXPIRATION_HEURES=24
APP_INSCRIPTION_VERSION_CONSENTEMENT_CNDP=1.0

# Réinitialisation de mot de passe
APP_REINIT_TOKEN_EXPIRATION_MINUTES=30
APP_REINIT_MAX_PAR_IP=5
APP_REINIT_MAX_PAR_EMAIL=3
APP_REINIT_FENETRE_SECONDES=3600
APP_REINIT_DELAI_COOLDOWN_SECONDES=60

# Espace Technicien (CMD-13)
# Plafond de durée déclarée par essai (minutes, défaut 480 = 8h)
LIMS_TECHNICIEN_DUREE_MAX_MINUTES=480
# Taille max d'un fichier CSV d'import (octets, défaut 1 048 576 = 1 Mo)
LIMS_TECHNICIEN_IMPORT_TAILLE_MAX_OCTETS=1048576
# Nombre max de lignes dans le CSV (défaut 500)
LIMS_TECHNICIEN_IMPORT_LIGNES_MAX=500

# Signature électronique des rapports (PAdES)
# Mot de passe des coffres de certificats (un fichier .p12 par laboratoire, sous APP_STORAGE_PATH/certificats)
APP_SIGNATURE_KEYSTORE_PASSWORD=change-me
# Horodatage RFC 3161 gratuit (FreeTSA). Mettre false pour signer sans horodatage (hors ligne).
APP_SIGNATURE_TSA_ENABLED=true
APP_SIGNATURE_TSA_URL=https://freetsa.org/tsr
