        "html": "=<div style=\"margin:0;padding:24px 12px;background:#F4F7F6;font-family:Arial,Helvetica,sans-serif;color:#1A2A2E\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">\n    Un nouvel essai vous a été affecté.\n  </div>\n\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px;margin:0 auto;background:#FFFFFF;border-radius:16px;overflow:hidden\">\n    <tr>\n      <td style=\"padding:22px 28px;background:#1A4A54\">\n        <p style=\"margin:0;color:#C8E86A;font-size:13px;font-weight:bold;letter-spacing:1px\">LABFLOW LIMS</p>\n        <h1 style=\"margin:8px 0 0;color:#FFFFFF;font-size:22px;line-height:1.3\">Un essai vous a été affecté</h1>\n      </td>\n    </tr>\n\n    <tr>\n      <td style=\"padding:28px;background:#FFFFFF;color:#1A2A2E;font-size:15px;line-height:1.6\">\n        <p style=\"margin:0 0 12px;color:#1A2A2E\">\n          {{ 'Bonjour ' + $json.body.nom + ',' }}\n        </p>\n\n        <p style=\"margin:0 0 16px;color:#1A2A2E\">\n          Un essai nécessite votre prise en charge. Voici les informations associées :\n        </p>\n\n        <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:16px 0;border:1px solid #D7E4E2;border-radius:12px;background:#FFFFFF\">\n          <tr>\n            <td style=\"width:35%;padding:11px 14px;color:#5B6B70;font-size:14px;border-bottom:1px solid #EEF3F2\">Essai</td>\n            <td style=\"padding:11px 14px;background:#FFFFFF;color:#1A2A2E;font-size:14px;font-weight:bold;border-bottom:1px solid #EEF3F2\">\n              {{ $json.body.designationEssai || 'Non renseigné' }}\n              {{ $json.body.reaffectation ? '(réaffectation)' : '' }}\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:11px 14px;color:#5B6B70;font-size:14px;border-bottom:1px solid #EEF3F2\">Échantillon</td>\n            <td style=\"padding:11px 14px;background:#FFFFFF;color:#1A2A2E;font-size:14px;font-weight:bold;border-bottom:1px solid #EEF3F2\">\n              {{ $json.body.referenceEchantillon || 'Non renseigné' }}\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:11px 14px;color:#5B6B70;font-size:14px;border-bottom:1px solid #EEF3F2\">Demande</td>\n            <td style=\"padding:11px 14px;background:#FFFFFF;color:#1A2A2E;font-size:14px;font-weight:bold;border-bottom:1px solid #EEF3F2\">\n              {{ $json.body.referenceDemande || 'Non renseignée' }}\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:11px 14px;color:#5B6B70;font-size:14px;border-bottom:1px solid #EEF3F2\">Code de l’essai</td>\n            <td style=\"padding:11px 14px;background:#FFFFFF;color:#1A2A2E;font-size:14px;font-weight:bold;border-bottom:1px solid #EEF3F2\">\n              {{ $json.body.codeLigne || 'Non renseigné' }}\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:11px 14px;color:#5B6B70;font-size:14px\">Date prévue</td>\n            <td style=\"padding:11px 14px;background:#FFFFFF;color:#1A2A2E;font-size:14px;font-weight:bold\">\n              {{ $json.body.datePrevue || 'À définir' }}\n            </td>\n          </tr>\n        </table>\n\n        <p style=\"margin:0 0 12px;color:#1A2A2E\">\n          Laboratoire : <strong>{{ $json.body.nomLaboratoire || 'Non renseigné' }}</strong>\n        </p>\n\n        <p style=\"margin:0 0 12px;color:#1A2A2E\">\n          Consultez votre espace technicien pour prendre en charge cet essai.\n        </p>\n\n        <p style=\"margin:24px 0 0;color:#5B6B70;font-size:13px\">L’équipe LabFlow</p>\n      </td>\n    </tr>\n\n    <tr>\n      <td style=\"padding:16px 28px 24px;background:#FFFFFF;color:#7A8A8E;font-size:12px\">\n        Cet e-mail a été envoyé automatiquement. Merci de ne pas y répondre.\n      </td>\n    </tr>\n  </table>\n</div>",
