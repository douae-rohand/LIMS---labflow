    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $json;\nconst li = (x) => '<li style=\"margin:0 0 6px\">' + (typeof x === 'object' && x !== null ? Object.values(x).filter(v => v !== null && v !== undefined).join(' - ') : x) + '</li>';\nconst bloc = (titre, liste, couleur) => (liste && liste.length)\n  ? '<h3 style=\"margin:20px 0 8px;color:' + couleur + ';font-size:16px\">' + titre + ' (' + liste.length + ')</h3><ul style=\"margin:0;padding-left:20px;font-size:14px\">' + liste.map(li).join('') + '</ul>' : '';\nconst html = '<div style=\"margin:0;padding:24px 12px;background:#F4F7F6;font-family:Arial,Helvetica,sans-serif;color:#1A2A2E\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px;margin:0 auto;background:#FFFFFF;border-radius:16px;overflow:hidden\"><tr><td style=\"padding:22px 28px;background:#1A4A54\"><p style=\"margin:0;color:#C8E86A;font-size:13px;font-weight:bold;letter-spacing:1px\">LABFLOW LIMS</p><h1 style=\"margin:8px 0 0;color:#FFFFFF;font-size:22px;line-height:1.3\">Alertes de stock</h1></td></tr><tr><td style=\"padding:28px;font-size:15px;line-height:1.6;color:#1A2A2E\"><p style=\"margin:0 0 12px\">Récapitulatif quotidien pour <b>' + d.laboratoireNom + '</b>.</p>'\n  + bloc('Rupture de stock', d.rupture, '#B3261E') + bloc('Sous le seuil minimal', d.sousSeuil, '#B26A00')\n  + bloc('Lots périmés', d.perimes, '#B3261E') + bloc('Péremption proche', d.peremptionProche, '#B26A00')\n  + '<p style=\"margin:24px 0 0;color:#5B6B70;font-size:13px\">L\\'équipe LabFlow</p></td></tr><tr><td style=\"padding:16px 28px 24px;color:#7A8A8E;font-size:12px\">Cet e-mail a été envoyé automatiquement. Merci de ne pas y répondre.</td></tr></table></div>';\nreturn { json: { to: (d.adminEmails || []).join(','), subject: 'Alertes de stock - ' + d.laboratoireNom, html } };"
      },
