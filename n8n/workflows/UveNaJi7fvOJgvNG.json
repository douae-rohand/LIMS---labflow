        "html": "=<div style=\"margin:0;padding:24px 12px;background:#F4F7F6;font-family:Arial,Helvetica,sans-serif;color:#1A2A2E\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">\n    Une facture du laboratoire est arrivée à échéance.\n  </div>\n\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px;margin:0 auto;background:#FFFFFF;border-radius:16px;overflow:hidden\">\n    <tr>\n      <td style=\"padding:22px 28px;background:#1A4A54\">\n        <p style=\"margin:0;color:#C8E86A;font-size:13px;font-weight:bold;letter-spacing:1px\">LABFLOW LIMS</p>\n        <h1 style=\"margin:8px 0 0;color:#FFFFFF;font-size:22px;line-height:1.3\">Facture arrivée à échéance</h1>\n      </td>\n    </tr>\n\n    <tr>\n      <td style=\"padding:28px;font-size:15px;line-height:1.6\">\n        <p style=\"margin:0 0 12px\">\n          {{ 'Bonjour ' + ($json.clientNom || $json.nom) + ',' }}\n        </p>\n\n        <p style=\"margin:0 0 12px\">\n          {{ 'La facture ' + $json.numeroFacture + ' du laboratoire ' + ($json.laboratoireNom || $json.nomLaboratoire) + ' est arrivée à échéance le ' + $json.dateEcheance + '.' }}\n        </p>\n\n        <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:20px 0;background:#F4F7F6;border:1px solid #D7E4E2;border-radius:12px\">\n          <tr>\n            <td style=\"padding:16px 18px;color:#5B6B70;font-size:14px\">\n              Montant restant dû\n            </td>\n            <td align=\"right\" style=\"padding:16px 18px;color:#1A4A54;font-size:18px;font-weight:bold\">\n              {{ $json.montantRestant }} MAD\n            </td>\n          </tr>\n        </table>\n\n        <p style=\"margin:0 0 12px\">\n          Merci de régulariser votre paiement. Si vous avez déjà effectué le règlement, vous pouvez ignorer ce message.\n        </p>\n\n        <a href=\"{{ $json.lienEspaceClient || $json.lienFacture }}\"\n           style=\"display:inline-block;margin:16px 0 8px;padding:12px 22px;border-radius:999px;background:#1A4A54;color:#FFFFFF;font-size:14px;font-weight:bold;text-decoration:none\">\n          Consulter ma facture\n        </a>\n\n        <p style=\"margin:24px 0 0;color:#5B6B70;font-size:13px\">\n          L’équipe LabFlow\n        </p>\n      </td>\n    </tr>\n\n    <tr>\n      <td style=\"padding:16px 28px 24px;color:#7A8A8E;font-size:12px\">\n        Cet e-mail a été envoyé automatiquement. Merci de ne pas y répondre.\n      </td>\n    </tr>\n  </table>\n</div>",
